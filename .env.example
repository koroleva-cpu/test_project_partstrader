# Copy to .env to set local defaults. Variables set in the shell take precedence.

# Which environment to run against: dev (working instance) or test (non-working instance).
TEST_ENV=dev

# Optional: watch the UI tests. Opens a visible browser and waits this many
# milliseconds before each action. Leave unset for normal headless runs.
# SLOW_MO=1000

# Optional: override the password used for every generated user in the selected environment.
# USER_PASSWORD=
